#!/bin/bash
#PBS -N reduction_nvidia
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=1:ngpus=1:mem=2GB
#PBS -l walltime=00:05:00
#PBS -j oe
#PBS -o reduction_nvidia.log

# Load module
module load craype-accel-nvidia80

cd "$PBS_O_WORKDIR"

# Compile the CUDA programs
nvcc -o reduction_nvidia reduction_nvidia.cu

# Run the programs
./reduction_nvidia 16777216   # 2^24 elements

